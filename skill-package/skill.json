{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "ja-JP": {
          "summary": "Anthropic Claudeと日本語で音声会話できるAlexaスキル",
          "examplePhrases": [
            "アレクサ、クロ先生を開いて",
            "今日の天気を教えて",
            "おしまい"
          ],
          "keywords": [
            "AI",
            "チャット",
            "会話",
            "アシスタント"
          ],
          "name": "クロ先生",
          "description": "Amazon AlexaデバイスからAIと自然な日本語会話ができるカスタムスキルです。質問に答えたり、会話を楽しんだりできます。\n\n【パーソナライズ機能】Voice IDで話者を識別し、お名前で挨拶します。この機能にはAlexaアプリでの権限許可が必要です。\n\n【リマインダー機能】会話中にリマインダーを設定できます。この機能にはAlexaアプリでの権限許可が必要です。\n\n詳細はプライバシーポリシーをご確認ください。"
        }
      },
      "isAvailableWorldwide": false,
      "testingInstructions": "開発者テストモードで使用。「アレクサ、クロ先生を開いて」でスキルを起動し、任意の質問をしてください。",
      "category": "EDUCATION_AND_REFERENCE",
      "distributionCountries": [
        "JP"
      ]
    },
    "apis": {
      "custom": {
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1024,
                "maxWidth": 1280,
                "minHeight": 600,
                "maxHeight": 800
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 960,
                "maxWidth": 1280,
                "minHeight": 480,
                "maxHeight": 600
              },
              {
                "mode": "HUB",
                "shape": "ROUND",
                "minWidth": 480,
                "maxWidth": 480,
                "minHeight": 480,
                "maxHeight": 480
              },
              {
                "mode": "TV",
                "shape": "RECTANGLE",
                "minWidth": 960,
                "maxWidth": 1920,
                "minHeight": 540,
                "maxHeight": 1080
              },
              {
                "mode": "MOBILE",
                "shape": "RECTANGLE",
                "minWidth": 320,
                "maxWidth": 600,
                "minHeight": 480,
                "maxHeight": 1000
              }
            ]
          }
        ]
      }
    },
    "manifestVersion": "1.0",
    "permissions": [
      {
        "name": "alexa::alerts:reminders:skill:readwrite"
      },
      {
        "name": "alexa::person_id:read"
      },
      {
        "name": "alexa::profile:given_name:read"
      },
      {
        "name": "alexa::profile:name:read"
      }
    ],
    "privacyAndCompliance": {
      "allowsPurchases": true,
      "locales": {
        "ja-JP": {
          "privacyPolicyUrl": "https://vercel-portfolio-site-koichi1115s-projects.vercel.app/legal/claude-alexa/privacy",
          "termsOfUseUrl": "https://vercel-portfolio-site-koichi1115s-projects.vercel.app/legal/claude-alexa/terms"
        }
      },
      "containsAds": false,
      "isExportCompliant": true,
      "isChildDirected": false,
      "usesPersonalInfo": true
    }
  }
}
